# Agent 服务端环境变量(复制为 .env 使用,勿提交真实值)
PORT=3000

# 前端鉴权 appKey(与前端 SDK 保持一致;生产用密钥管理服务下发)
APP_KEY=DEV_APP_KEY_PLACEHOLDER

# 允许跨域的前端域名(生产必须收敛为具体域名)
CORS_ORIGIN=*

# —— 双 MCP 服务端 SSE 地址 ——
MCP_A_SSE_URL=http://localhost:4001/sse
MCP_B_SSE_URL=http://localhost:4002/sse

# —— LLM 配置 ——
# USE_MOCK_LLM=true 时使用规则/mock LLM,便于无 key 联调;生产设为 false
USE_MOCK_LLM=true
LLM_API_BASE=https://api.example-llm.com/v1
LLM_API_KEY=REPLACE_WITH_LLM_KEY
LLM_MODEL=your-function-calling-model

# —— 缓存 ——
# USE_MOCK_CACHE=true 用内存缓存;生产建议 Redis
USE_MOCK_CACHE=true
REDIS_URL=redis://127.0.0.1:6379